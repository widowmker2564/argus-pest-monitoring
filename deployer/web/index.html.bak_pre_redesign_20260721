        <div id="tr-classes" style="margin-top:8px"></div>
        <div id="tr-warnings" style="font-size:12.5px;color:var(--caution);line-height:1.7;margin-top:8px"></div>
        <div id="tr-blockers" style="font-size:13px;color:#b3261e;font-weight:600;line-height:1.7;margin-top:8px"></div>
      </div>
    </div>

    <!-- 2: cost gate -->
    <div class="glass costcard rv" id="tr-gate" style="display:none;margin-top:18px">
      <div class="clabel">BEFORE TRAINING &#8212; THE COST</div>
      <div class="figure grad" id="tr-cost">&#8776; $0</div>
      <div class="breakdown" id="tr-cost-detail"></div>
      <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;align-items:center">
        <input class="fld" id="tr-confirm" placeholder="type TRAIN to confirm" spellcheck="false"
               autocomplete="off" style="flex:1;min-width:180px" oninput="trGateCheck()">
        <button class="btn on-dark" id="tr-start" disabled onclick="trStart()">Start training
          <svg class="arr" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1.5 6h9M7 2.5 10.5 6 7 9.5"/></svg>
        </button>
      </div>
      <p class="fhint">Billed by AWS to your account. You can close this app once
        training starts &#8212; it continues in the cloud and Argus re-attaches on relaunch.</p>
    </div>

    <!-- 3: progress -->
    <div id="tr-run" style="display:none;margin-top:18px">
      <div class="assist" style="margin-top:0">
        <nav class="rail">
          <ol id="tr-rail">
            <li><span class="dot">1</span><div><h4>Check the data</h4></div></li>
            <li><span class="dot">2</span><div><h4>Convert labels</h4></div></li>
            <li><span class="dot">3</span><div><h4>Upload images</h4></div></li>
            <li><span class="dot">4</span><div><h4>Load the vision engine</h4></div></li>
            <li><span class="dot">5</span><div><h4>Train</h4><p id="tr-elapsed"></p></div></li>
            <li><span class="dot">6</span><div><h4>Wire into cameras</h4></div></li>
          </ol>
        </nav>
        <div>
          <div class="feed" id="tr-feed" style="margin:0;max-width:none;max-height:340px;overflow-y:auto"></div>
        </div>
      </div>
    </div>

    <!-- 4: done -->
    <div class="glass cfg" id="tr-result" style="display:none;margin-top:18px">
      <div class="clabel" style="font-size:12px;letter-spacing:.1em;color:var(--muted)">MODEL TRAINED &amp; WIRED IN</div>
      <div class="figure grad" id="tr-f1" style="font-size:42px;font-weight:700;letter-spacing:-.03em">F1 &#8212;</div>
      <p class="fhint" id="tr-f1-note" style="max-width:56ch"></p>
      <p class="fhint" style="max-width:56ch">Detection is <b>not</b> started automatically
        &#8212; running the model costs US$4/hour. Start it from your dashboard when you
        are ready; the cost guard stops forgotten models.</p>
      <div style="display:flex;gap:10px;margin-top:14px;flex-wrap:wrap">
        <button class="btn" id="tr-again" onclick="trReset()">Train a new version</button>
        <button class="btn" id="tr-rollback" style="display:none" onclick="trRollback()">Roll back to the previous model</button>
      </div>
      <p class="fhint" id="tr-rollback-msg"></p>
    </div>

    <div class="nav rv" style="--i:4">
      <button class="back" onclick="go('done')">Back to summary</button>
    </div>
  </div>
</section>

<script>
"use strict";
/* ===================== APERTURE ENGINE ===================== */
const cv = document.getElementById('stage');
const cx2d = cv.getContext('2d');
const DPR = Math.min(window.devicePixelRatio || 1, 1.5);
const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
let W = 0, H = 0;
function resize() {
  W = innerWidth; H = innerHeight;
  cv.width = W * DPR; cv.height = H * DPR;
  cv.style.width = W + 'px'; cv.style.height = H + 'px';
  cx2d.setTransform(DPR, 0, 0, DPR, 0, 0);
}
resize(); addEventListener('resize', resize);

/* aperture state (lerped toward per-screen targets) */
const AP = { x: .5, y: .42, r: 0, open: 0, alpha: 0, field: 0,
             tx: .5, ty: .42, tr: 260, topen: .84, talpha: 1, tfield: 1 };
const PRESETS = {
  welcome: { x: .5, y: .40, r: () => Math.min(H * .30, 270), open: .84, alpha: 1, field: 1 },
  consent: { x: .5, y: .42, r: () => 0, open: .84, alpha: 0, field: 0 },
  account: { x: .5, y: .42, r: () => 0, open: .84, alpha: 0, field: 0 },
  keys:    { x: .5, y: .42, r: () => 0, open: .84, alpha: 0, field: 0 },
  config:  { x: .72, y: .5, r: () => Math.min(H * .34, 300), open: .84, alpha: .5, field: .8 },
  review:  { x: .5, y: .42, r: () => 0, open: .84, alpha: 0, field: 0 },
  theater: { x: .5, y: .34, r: () => Math.min(H * .21, 190), open: .08, alpha: 1, field: .9 },
  done:    { x: .5, y: .38, r: () => Math.min(H * .24, 220), open: 1, alpha: 1, field: 1 },
  train:   { x: .76, y: .5, r: () => Math.min(H * .28, 250), open: .84, alpha: .45, field: .8 },
};

/* particles */
const N = REDUCED ? 90 : 240;
const parts = [];
for (let i = 0; i < N; i++) {
  const z = .2 + Math.random() * .8;
  parts.push({ u: Math.random() * 2 - 1, v: Math.random() * 2 - 1, z,
    a: Math.random() * Math.PI * 2, sp: (4 + Math.random() * 6) / 60,
    teal: Math.random() < .06, violet: Math.random() < .02 });
}
let mouseX = 0, mouseY = 0, mx = 0, my = 0;
addEventListener('mousemove', e => {
  mouseX = (e.clientX / W - .5) * 2; mouseY = (e.clientY / H - .5) * 2;
});

/* lock-on */
const lock = { active: false, t: 0, x: 0, y: 0, w: 0, label: '', conf: '' };
let lockTimer = 2000;
let targetLabel = 'TARGET';
function setTarget(v) {
  targetLabel = (v || 'TARGET').trim().toUpperCase() || 'TARGET';
  const echo = document.getElementById('target-echo');
  if (echo) echo.textContent = targetLabel;
}
function fireLock(labelOverride) {
  const r = AP.r * AP.open * .5;
  const ang = Math.random() * Math.PI * 2, d = Math.random() * r * .5;
  lock.active = true; lock.t = 0;
  lock.x = AP.x * W + Math.cos(ang) * d;
  lock.y = AP.y * H + Math.sin(ang) * d;
  lock.w = 34 + Math.random() * 26;
  lock.label = labelOverride || targetLabel;
  lock.conf = (91 + Math.random() * 8.2).toFixed(1) + '%';
}

/* shutter: random snaps + user-click snaps; drives blades AND the shader flash
   through window.__shutterPulse so light and mechanics stay in sync. */
const SH = { t: -1, next: 5 + Math.random() * 7 };
window.__shutterPulse = 0;
function snapFactor() {
  if (SH.t < 0) return 1;
  const t = SH.t;
  if (t < 0.09) return 1 - (t / 0.09) * 0.94;                 // slam shut
  if (t < 0.16) return 0.06;                                   // hold
  if (t < 0.55) { const p = (t - 0.16) / 0.39;                 // spring back
    return 0.06 + (1 - 0.06) * (1 - Math.pow(1 - p, 3)); }
  return 1;
}
let audioCtx = null;
function shutterSound() {
  try {
    audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
    const t = audioCtx.currentTime;
    [0, 0.07].forEach((off, k) => {
      const len = Math.floor(audioCtx.sampleRate * 0.03);
      const buf = audioCtx.createBuffer(1, len, audioCtx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 2);
      const src = audioCtx.createBufferSource(); src.buffer = buf;
      const g = audioCtx.createGain();
      g.gain.value = k === 0 ? 0.12 : 0.07;
      src.connect(g); g.connect(audioCtx.destination);
      src.start(t + off);
    });
  } catch (e) {}
}
function triggerShutter(userClick) {
  if (REDUCED || AP.alpha < 0.5) return;
  SH.t = 0;
  SH.next = 6 + Math.random() * 9;
  if (userClick) shutterSound();
}
document.addEventListener('pointerdown', (e) => {
  if (AP.alpha < 0.5) return;
  const dx = e.clientX - AP.x * W, dy = e.clientY - AP.y * H;
  if (Math.hypot(dx, dy) <= AP.r * 1.05) triggerShutter(true);
});

let ringProg = REDUCED ? 1 : 0;
let breath = 0;
let last = performance.now();

function draw(now) {
  const dt = Math.min((now - last) / 1000, .05); last = now;
  /* lerp state */
  const L = REDUCED ? 1 : .07;
  AP.x += (AP.tx - AP.x) * L; AP.y += (AP.ty - AP.y) * L;
  AP.r += (AP.tr - AP.r) * L; AP.open += (AP.topen - AP.open) * L;
  AP.alpha += (AP.talpha - AP.alpha) * L; AP.field += (AP.tfield - AP.field) * L;
  mx += (mouseX - mx) * .06; my += (mouseY - my) * .06;
  if (ringProg < 1) ringProg = Math.min(1, ringProg + dt / .8);
  breath += dt;
  // shutter clock: advance an active snap; count down to the next random one
  if (SH.t >= 0) { SH.t += dt; if (SH.t > 0.6) SH.t = -1; }
  else if (!REDUCED && AP.alpha > 0.5) {
    SH.next -= dt; if (SH.next <= 0) triggerShutter(false);
  }
  // ONE source of truth for the snap. The blades, the light-field dimming and the
  // flash are ALL derived from snapFactor(), so they physically cannot drift out
  // of phase. (Bug through 2026-07-15: the flash ran on its own 0.35 s linear
  // decay — peaking at t=0 while the blades were still wide open — and the shader
  // ignored the snap entirely, so the light never dimmed when the shutter shut.)
  const snap = snapFactor();
  window.__shutterSnap = snap;                    // 1 = wide open, ~0.06 = shut
  window.__shutterPulse = Math.max(0, 1 - snap);  // peaks exactly when blades are shut

  cx2d.clearRect(0, 0, W, H);
  if (AP.alpha < .01) { requestAnimationFrame(draw); return; }

  const cx = AP.x * W + (REDUCED ? 0 : -mx * 3);
  const cy = AP.y * H + (REDUCED ? 0 : -my * 3);
  const R = AP.r * (1 + (REDUCED ? 0 : Math.sin(breath * 2 * Math.PI / 7) * .008));
  const open = AP.open * snap;
  const rh = Math.max(2, open * R * .62);
  const K = 9, twist = (1 - open) * .35;

  /* particle positions this frame */
  const px = [], py = [];
  for (const p of parts) {
    if (!REDUCED) {
      p.a += (Math.sin(now / 3000 + p.z * 9) * .5) * dt;
      p.u += Math.cos(p.a) * p.sp * dt; p.v += Math.sin(p.a) * p.sp * dt;
      if (p.u > 1.3) p.u = -1.3; if (p.u < -1.3) p.u = 1.3;
      if (p.v > 1.3) p.v = -1.3; if (p.v < -1.3) p.v = 1.3;
    }
    px.push(cx + p.u * R + mx * 10 * p.z);
    py.push(cy + p.v * R + my * 10 * p.z);
  }
  function paintField(alphaMul) {
    for (let i = 0; i < parts.length; i++) {
      const p = parts[i];
      const base = p.teal ? 'rgba(10,132,255,' : p.violet ? 'rgba(175,82,222,' : 'rgba(29,29,31,';
      const a = (p.teal ? .4 : p.violet ? .35 : .1 + p.z * .25) * alphaMul;
      cx2d.fillStyle = base + a + ')';
      cx2d.beginPath();
      cx2d.arc(px[i], py[i], (0.6 + p.z * 1.6), 0, 7);
      cx2d.fill();
    }
  }

  cx2d.globalAlpha = AP.alpha;

  /* faint bleed everywhere */
  paintField(.25 * AP.field);

  /* disk field */
  cx2d.save();
  cx2d.beginPath(); cx2d.arc(cx, cy, R, 0, 7); cx2d.clip();
  paintField(.55 * AP.field);
  cx2d.restore();

  /* bright pass inside the hole polygon */
  cx2d.save();
  cx2d.beginPath();
  const rv = rh / Math.cos(Math.PI / K);
  for (let k = 0; k <= K; k++) {
    const a = twist + (k + .5) * 2 * Math.PI / K;
    const vx = cx + Math.cos(a) * rv, vy = cy + Math.sin(a) * rv;
    k ? cx2d.lineTo(vx, vy) : cx2d.moveTo(vx, vy);
  }
  cx2d.clip();
  paintField(1 * AP.field);
  /* center glow */
  const g = cx2d.createRadialGradient(cx, cy, 0, cx, cy, rh);
  g.addColorStop(0, 'rgba(10,132,255,' + (.12 * AP.field) + ')');
  g.addColorStop(1, 'rgba(10,132,255,0)');
  cx2d.fillStyle = g; cx2d.fillRect(cx - rh, cy - rh, rh * 2, rh * 2);
  cx2d.restore();

  /* blades: 9 circular segments.
     TWO PASSES, fills first and edges after — interleaving fill/stroke per
     blade let each later fill paint OVER the earlier blades' edge lines
     (segments overlap heavily when nearly closed), which erased the edges of
     blades 0-2 and made the k=0 region read as one giant blade (the
     "right-hand blade is huge" bug, fixed 2026-07-15). Edges are drawn from
     each blade's tangent point to its leading rim end, so all nine are
     congruent by construction — a uniform pinwheel at any opening. */
  if (rh < R - 1) {
    const phi = Math.acos(Math.min(1, rh / R));
    cx2d.fillStyle = '#e6eaf1';
    for (let k = 0; k < K; k++) {
      const a = twist + k * 2 * Math.PI / K;
      cx2d.beginPath();
      cx2d.arc(cx, cy, R, a - phi, a + phi);
      cx2d.closePath();
      cx2d.fill();
    }
    cx2d.strokeStyle = 'rgba(30,40,60,.30)';
    cx2d.lineWidth = 1;
    for (let k = 0; k < K; k++) {
      const a = twist + k * 2 * Math.PI / K;
      const tx = cx + Math.cos(a) * rh,        ty = cy + Math.sin(a) * rh;
      const ex = cx + Math.cos(a + phi) * R,   ey = cy + Math.sin(a + phi) * R;
      cx2d.beginPath(); cx2d.moveTo(tx, ty); cx2d.lineTo(ex, ey); cx2d.stroke();
    }
  }

  /* ring */
  cx2d.strokeStyle = 'rgba(30,40,60,.30)';
  cx2d.lineWidth = 1;
  cx2d.beginPath();
  cx2d.arc(cx, cy, R, -Math.PI / 2, -Math.PI / 2 + ringProg * 2 * Math.PI);
  cx2d.stroke();

  /* lock-on */
  if (!REDUCED && AP.field > .4 && open > .3) {
    lockTimer -= dt * 1000;
    if (lockTimer <= 0 && !lock.active) { fireLock(); lockTimer = 4500 + Math.random() * 2500; }
  }
  if (lock.active) {
    lock.t += dt;
    const T = lock.t;
    let prog = Math.min(1, T / .6);
    prog = 1 - Math.pow(1 - prog, 3);
    const fade = T > 2.0 ? Math.max(0, 1 - (T - 2.0) / 1.2) : 1;
    if (T > 3.2) lock.active = false;
    const spread = (1 - prog) * 40;
    const hw = lock.w / 2 + spread;
    const bl = 9;
    cx2d.strokeStyle = 'rgba(10,132,255,' + (.95 * fade * AP.alpha) + ')';
    cx2d.lineWidth = 1.5;
    const corners = [[-1, -1], [1, -1], [-1, 1], [1, 1]];
    for (const [sx, sy] of corners) {
      const bx = lock.x + sx * hw, by = lock.y + sy * hw;
      cx2d.beginPath();
      cx2d.moveTo(bx - sx * bl, by); cx2d.lineTo(bx, by); cx2d.lineTo(bx, by - sy * bl);
      cx2d.stroke();
    }
    if (prog >= 1 && fade > 0) {
      const chars = Math.floor(Math.min(1, (T - .6) / .25) * (lock.label.length + 8));
      const txt = (lock.label + ' · ' + lock.conf).slice(0, chars);
      cx2d.font = '11px ui-monospace, SF Mono, Cascadia Code, Consolas, monospace';
      cx2d.fillStyle = 'rgba(10,132,255,' + (.95 * fade * AP.alpha) + ')';
      cx2d.fillText(txt, lock.x + hw + 10, lock.y - hw + 4);
      cx2d.strokeStyle = 'rgba(10,132,255,' + (.45 * fade * AP.alpha) + ')';
      cx2d.beginPath(); cx2d.moveTo(lock.x + hw, lock.y - hw);
      cx2d.lineTo(lock.x + hw + 7, lock.y - hw + 1); cx2d.stroke();
    }
  }

  cx2d.globalAlpha = 1;
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);

/* film grain (runtime-generated, CSP-safe) */
(function grain() {
  const g = document.getElementById('grain'), gx = g.getContext('2d');
  const t = document.createElement('canvas'); t.width = t.height = 128;
  const tx = t.getContext('2d'), img = tx.createImageData(128, 128);
  for (let i = 0; i < img.data.length; i += 4) {
    const v = Math.random() * 255;
    img.data[i] = img.data[i + 1] = img.data[i + 2] = v; img.data[i + 3] = 255;
  }
  tx.putImageData(img, 0, 0);
  function paint() {
    g.width = innerWidth; g.height = innerHeight;
    gx.fillStyle = gx.createPattern(t, 'repeat');
    gx.fillRect(0, 0, g.width, g.height);
  }
  paint(); addEventListener('resize', paint);
})();

/* ==================================================================
   ATMOSPHERE — WebGL2 caustic light-field + curl-noise flow behind
   the Canvas2D aperture. Reads the existing aperture state (AP.open,
   AP.x/y/alpha) and the lock-on pulse so it breathes in lockstep.
   Hard fallback: if WebGL2 is unavailable / blocklisted / reduced-
   motion, it stays blank and the Canvas2D hero carries the screen —
   the hero NEVER goes blank.
   ================================================================== */
(function atmosphere() {
  const cv = document.getElementById('atmosphere');
  if (REDUCED) { return; }                    // reduced-motion: no shader (spec C.6)
  let gl;
  try { gl = cv.getContext('webgl2', { antialias: false, alpha: true }); } catch (e) {}
  if (!gl) { return; }                        // no WebGL2: Canvas2D hero stands alone

  const VERT = `#version 300 es
  const vec2 P[3] = vec2[3](vec2(-1.,-1.), vec2(3.,-1.), vec2(-1.,3.));
  void main(){ gl_Position = vec4(P[gl_VertexID], 0., 1.); }`;

  // Ashima-style 2D simplex noise (public domain) + caustic + curl, one draw call.
  const FRAG = `#version 300 es
  precision highp float;
  uniform vec2 uRes; uniform float uTime; uniform float uAperture;
  uniform float uLockPulse; uniform vec2 uMouse; uniform vec2 uCenter;
  uniform float uRingR;
  out vec4 o;
  vec3 permute(vec3 x){ return mod(((x*34.0)+1.0)*x, 289.0); }
  float snoise(vec2 v){
    const vec4 C=vec4(0.211324865,0.366025404,-0.577350269,0.024390243);
    vec2 i=floor(v+dot(v,C.yy)); vec2 x0=v-i+dot(i,C.xx);
    vec2 i1=(x0.x>x0.y)?vec2(1.,0.):vec2(0.,1.);
    vec4 x12=x0.xyxy+C.xxzz; x12.xy-=i1;
    i=mod(i,289.0);
    vec3 p=permute(permute(i.y+vec3(0.,i1.y,1.))+i.x+vec3(0.,i1.x,1.));
    vec3 m=max(0.5-vec3(dot(x0,x0),dot(x12.xy,x12.xy),dot(x12.zw,x12.zw)),0.0);
    m=m*m; m=m*m;
    vec3 x=2.0*fract(p*C.www)-1.0; vec3 h=abs(x)-0.5; vec3 ox=floor(x+0.5); vec3 a0=x-ox;
    m*=1.79284291-0.85373472*(a0*a0+h*h);
    vec3 g; g.x=a0.x*x0.x+h.x*x0.y; g.yz=a0.yz*x12.xz+h.yz*x12.yw;
    return 130.0*dot(m,g);
  }
  float n2(vec2 p){ return 0.5+0.5*snoise(p); }
  vec2 curl(vec2 p){ float e=0.01;
    float dx=n2(p+vec2(e,0.))-n2(p-vec2(e,0.));
    float dy=n2(p+vec2(0.,e))-n2(p-vec2(0.,e));
    return vec2(dy,-dx)/(2.*e); }
  float caustic(vec2 uv,float t){ float s=0.;
    s+=pow(n2(uv*3.0+vec2(t*0.08,-t*0.05)),6.0);
    s+=pow(n2(uv*6.0-vec2(t*0.05,t*0.09)),8.0)*0.6;
    s+=pow(n2(uv*1.5+t*0.03),4.0)*0.4;
    return s; }
  void main(){
    vec2 uv=(gl_FragCoord.xy - uCenter*uRes)/uRes.y;  // origin AT the aperture centre
    uv+=uMouse*0.03;
    float r=length(uv);
    float c=caustic(uv,uTime)*mix(0.12,1.0,smoothstep(1.0,0.0,r))*uAperture;
    vec2 flow=curl(uv*2.0+uTime*0.05);
    float streak=smoothstep(0.6,1.0,abs(sin(dot(flow,uv)*8.0+uTime)))*smoothstep(1.2,0.2,r);
    float ring=smoothstep(0.02,0.0,abs(r-uRingR))*uLockPulse;
    vec3 col=vec3(0.04,0.42,0.95);
    col=mix(col, vec3(0.55,0.30,0.85), streak*0.5);
    col=mix(col, vec3(0.02,0.30,0.85), ring);
    float a=clamp(c*0.55+streak*0.18+ring*0.85, 0.0, 0.75)*uAperture;
    o=vec4(col, a);
  }`;

  function sh(type, src) {
    const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.warn(gl.getShaderInfoLog(s)); return null; }
    return s;
  }
  const vs = sh(gl.VERTEX_SHADER, VERT), fs = sh(gl.FRAGMENT_SHADER, FRAG);
  if (!vs || !fs) { return; }
  const prog = gl.createProgram();
  gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);
  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { console.warn(gl.getProgramInfoLog(prog)); return; }
  gl.useProgram(prog);
  const U = n => gl.getUniformLocation(prog, n);
  const uRes = U('uRes'), uTime = U('uTime'), uAperture = U('uAperture'),
        uLockPulse = U('uLockPulse'), uMouse = U('uMouse'), uCenter = U('uCenter'),
        uRingR = U('uRingR');
  const vao = gl.createVertexArray(); gl.bindVertexArray(vao);
  gl.enable(gl.BLEND); gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA); // soft tint on white

  const DPR = Math.min(devicePixelRatio || 1, 1.5);
  function resize() {
    cv.width = Math.floor(innerWidth * DPR); cv.height = Math.floor(innerHeight * DPR);
    cv.style.width = innerWidth + 'px'; cv.style.height = innerHeight + 'px';
    gl.viewport(0, 0, cv.width, cv.height);
  }
  resize(); addEventListener('resize', resize);

  const t0 = performance.now();
  function frame() {
    // AP + lock come from the Canvas2D engine above (shared globals)
    gl.uniform2f(uRes, cv.width, cv.height);
    gl.uniform1f(uTime, (performance.now() - t0) / 1000);
    // Multiply by the SAME snap factor the blades use (window.__shutterSnap), so
    // the light field goes dark at the exact instant the shutter closes. Reading
    // raw AP.open here was the desync: mechanics snapped, light did not.
    const snap = window.__shutterSnap ?? 1;
    gl.uniform1f(uAperture, Math.max(0, AP.alpha) * (0.35 + 0.65 * AP.open * snap));
    const lockWhisper = (typeof lock !== 'undefined' && lock.active)
      ? 0.25 * Math.max(0, 1 - lock.t / 1.4) : 0;
    gl.uniform1f(uLockPulse, Math.max(window.__shutterPulse || 0, lockWhisper));
    gl.uniform2f(uMouse, (typeof mx !== 'undefined' ? mx : 0), (typeof my !== 'undefined' ? my : 0));
    gl.uniform2f(uCenter, AP.x, 1 - AP.y);
    gl.uniform1f(uRingR, AP.r / innerHeight);   // ring radius tracks the blades' radius
    gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT);
    if (AP.alpha > 0.01) gl.drawArrays(gl.TRIANGLES, 0, 3);
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();

/* ===================== ROUTER ===================== */
function go(name) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  const scr = document.getElementById('s-' + name);
  scr.querySelectorAll('.rv').forEach(el => { el.style.animation = 'none'; void el.offsetWidth; el.style.animation = ''; });
  scr.classList.add('active');
  // Resume memory: remember how far the user got + their config, so an
  // interrupted session can pick up exactly here on the next launch.
  // 'theater' is stored as 'review' (never resume INTO a live deploy screen).
  // go('done') must NOT overwrite argus.cfg: on the resume-to-summary path the
  // form still holds pristine defaults and would clobber the real config.
  try {
    if (name !== 'welcome' && name !== 'done')
      localStorage.setItem('argus.screen', name === 'theater' ? 'review' : name);
    if (name === 'done') localStorage.removeItem('argus.screen');
    else localStorage.setItem('argus.cfg', JSON.stringify(cfgFromForm()));
  } catch (e) {}
  // Any manual navigation invalidates a pending resume offer — a stale
  // "Resume deployment" button floating over a half-edited form is a footgun.
  const rb = document.getElementById('resume-bar');
  if (rb) rb.remove();
  if (name === 'done') { try { loadUsers(); } catch (e) {} }
  const p = PRESETS[name];
  AP.tx = p.x; AP.ty = p.y; AP.tr = p.r(); AP.topen = p.open;
  AP.talpha = p.alpha; AP.tfield = p.field;
  if (name === 'theater') { REAL ? startRealDeploy() : runTheater(); }
  if (name === 'config') { lockTimer = 600; }
  if (name === 'train') { trInit(); }
  // one-stop: AWS's own page opens alongside, inside the app, on these screens
  if (REAL && name === 'account') openAws('signup');
  if (REAL && name === 'keys') openAws('iam-keys');
  if (REAL && name !== 'account' && name !== 'keys' && window.pywebview)
    { try { pywebview.api.close_aws_pane(); } catch (e) {} }
  scr.scrollTop = 0;
}

