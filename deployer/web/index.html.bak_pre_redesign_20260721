  okline.querySelector('span') || null;
  try {
    const r = await pywebview.api.verify_credentials(ak, sk);
    if (r && r.ok && r.admin === false) {
      // The key authenticates but cannot deploy anything — stop HERE with the
      // exact fix, instead of 15 AccessDenied errors mid-deployment.
      okline.innerHTML = '&#9888; The key works, but user has no deploy rights. In the AWS window: '
        + 'IAM &#8594; Users &#8594; <span class="mono">deployer</span> &#8594; Add permissions &#8594; '
        + 'Attach policies directly &#8594; <span class="mono">AdministratorAccess</span> — then Continue again.';
      okline.style.color = 'var(--caution)';
      okline.classList.add('show');
      btn.disabled = false;
      openAws('iam-keys');
      return;
    }
    if (r && r.ok) {
      okline.style.color = '';
      okline.innerHTML = '<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.2 4.8 9 10 3.4"/></svg> Verified &#183; account ' + r.account + ' &#183; encrypted locally'
        + (r.admin === true ? ' &#183; deploy rights confirmed' : ' &#183; permissions unconfirmed');
      okline.classList.add('show');
      document.getElementById('fw-ak').classList.add('locked');
      document.getElementById('fw-sk').classList.add('locked');
      setTimeout(() => go('config'), 650);
    } else {
      okline.innerHTML = (r && r.error) ? r.error : 'Verification failed.';
      okline.style.color = 'var(--caution)';
      okline.classList.add('show');
      btn.disabled = false;
    }
  } catch (e) {
    okline.textContent = 'Could not reach the verifier.'; okline.classList.add('show');
    btn.disabled = false;
  }
}

/* --- real deployment: start_deploy + event-driven theater --- */
let realStages = [];       // filled from the first 'stage' event's total
let realStartT = 0;
async function startRealDeploy() {
  const feed = document.getElementById('feed');
  const fstop = document.getElementById('fstop');
  const nextBtn = document.getElementById('theater-next');
  feed.innerHTML = ''; nextBtn.classList.remove('show');
  fstop.textContent = 'f/16'; AP.topen = apertureProgress(0);
  realStartT = performance.now();
  const cfg = cfgFromForm();
  const r = await pywebview.api.start_deploy(cfg);
  if (!r || !r.ok) {
    feedLine('T+00:00.0', (r && r.error) ? r.error : 'Could not start deployment', 'err');
  }
}

function tplusNow() {
  const s = (performance.now() - realStartT) / 1000;
  return 'T+' + String(Math.floor(s / 60)).padStart(2, '0') + ':' +
    (s % 60).toFixed(1).padStart(4, '0');
}
function feedLine(ts, text, cls) {
  const feed = document.getElementById('feed');
  if (!feed) return;
  const div = document.createElement('div');
  const tag = cls === 'err' ? '<span class="ok" style="color:var(--caution)">FAIL</span>'
            : cls === 'ok' ? '<span class="ok">OK</span>' : '';
  div.innerHTML = '<span class="ts">' + ts + '</span>' + text + '  ' + tag;
  feed.appendChild(div);
  requestAnimationFrame(() => div.classList.add('show'));
  feed.scrollTop = feed.scrollHeight;
}

const FSTOPS = ['f/16','f/13','f/11','f/9','f/8','f/6.7','f/5.6','f/4.5','f/4',
                'f/3.4','f/2.8','f/2.4','f/2','f/1.8','f/1.4'];

/* config validation gate */
function validEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); }
function validateConfig() {
  const name = (document.getElementById('pname') || {}).value || '';
  const target = (document.getElementById('target') || {}).value || '';
  const email = (document.getElementById('email') || {}).value || '';
  const err = document.getElementById('email-err');
  const btn = document.getElementById('config-next');
  let emailMsg = '';
  if (email && !validEmail(email)) emailMsg = 'That does not look like a valid email address.';
  if (err) err.textContent = emailMsg;
  const ok = name.trim().length >= 2 && target.trim().length >= 2 && validEmail(email);
  if (btn) btn.disabled = !ok;
  return ok;
}
function configContinue() { if (validateConfig()) go('review'); }

/* Python -> JS event sink (app.py calls ARGUS.onDeployEvent) */
window.ARGUS = {
  onDeployEvent(e) {
    if (!e || !e.kind) return;
    if (e.kind.indexOf('train') === 0) { trEvent(e); return; }
    if (e.kind === 'aws_nav') { advanceAwsRail(e.url); return; }
    if (e.kind === 'stage') {
      if (e.status === 'running') {
        AP.topen = apertureProgress(e.index / Math.max(1, e.total));
        const fi = Math.min(FSTOPS.length - 1, Math.round(e.index / Math.max(1, e.total - 1) * (FSTOPS.length - 1)));
        document.getElementById('fstop').textContent = FSTOPS[fi];
        document.getElementById('plabel') && (document.getElementById('plabel').textContent = e.label);
        feedLine(tplusNow(), 'CREATE  ' + (e.label || e.name).toLowerCase(), null);
        fireLock((e.label || e.name).toUpperCase());
      } else if (e.status === 'done') {
        AP.topen = apertureProgress((e.index + 1) / Math.max(1, e.total));
        triggerShutter(false);   // each finished stage = the camera "captures" it
        const last = document.querySelector('#feed div:last-child');
        if (last && !last.querySelector('.ok')) last.innerHTML += '  <span class="ok">OK</span>';
      } else if (e.status === 'error') {
        const last = document.querySelector('#feed div:last-child');
        if (last) last.innerHTML += '  <span class="ok" style="color:var(--caution)">FAIL</span>';
      }
      return;
    }
    if (e.kind === 'log') { /* fine-grained lines are optional; stages are the spine */ return; }
    if (e.kind === 'done') {
      document.getElementById('fstop').textContent = 'f/1.4';
      AP.topen = 1;
      feedLine(tplusNow(), 'deployment complete', 'ok');
      if (e.dashboard) {
        const u = document.getElementById('dash-url');
        if (u) u.value = e.dashboard;
      }
      document.getElementById('theater-next').classList.add('show');
      return;
    }
    if (e.kind === 'error') {
      feedLine(tplusNow(), e.message || 'deployment error', 'err');
      return;
    }
    if (e.kind === 'destroy') {
      const lb = document.getElementById('destroy-log');
      if (lb) {
        lb.style.display = 'block';
        const d = document.createElement('div');
        d.textContent = e.line || '';
        d.style.color = e.ok ? '' : '#b3261e';
        lb.appendChild(d); lb.scrollTop = lb.scrollHeight;
      }
      return;
    }
    if (e.kind === 'destroy_done') {
      const lb = document.getElementById('destroy-log');
      if (lb) {
        const d = document.createElement('div');
        d.style.fontWeight = '600';
        d.textContent = (e.failed ? '⚠ Teardown finished with ' + e.failed + ' failure(s): '
          + (e.failures || []).join(', ')
          : 'Teardown finished — verifying against AWS…');
        lb.appendChild(d); lb.scrollTop = lb.scrollHeight;
      }
      return;   // navigation happens only after independent verification
    }
    if (e.kind === 'destroy_verified') {
      const lb = document.getElementById('destroy-log');
      if (lb) {
        const d = document.createElement('div');
        d.style.fontWeight = '600';
        if (e.live === 0) {
          d.textContent = '✓ VERIFIED — 0/' + e.total + ' resources remain. Account is clean.';
        } else {
          d.style.color = '#b3261e';
          d.textContent = '⚠ VERIFIED ' + e.live + '/' + e.total + ' resources STILL EXIST: '
            + (e.leftovers || []).join(', ') + ' — click Delete deployment again to retry.';
        }
        lb.appendChild(d); lb.scrollTop = lb.scrollHeight;
      }
      if (e.live === 0) {
        try { localStorage.removeItem('argus.screen'); localStorage.removeItem('argus.cfg'); } catch (x) {}
        showNote('Deployment removed and independently verified — returning to start.');
        setTimeout(() => {
          const u = document.getElementById('dash-url'); if (u) u.value = '';
          const ul = document.getElementById('user-list'); if (ul) ul.textContent = '…';
          go('welcome');
        }, 2600);
      }
      return;
    }
  }
};

/* ==================================================================
   TRAIN — the in-app training pipeline UI. Deterministic bridges only:
   pick folder -> analyze -> cost gate (typed TRAIN) -> start -> watch
   -> the model is wired into the cameras. All backend events arrive
   as train_* kinds and are routed here by onDeployEvent.
   ================================================================== */
const TR = { path: '', report: null, classId: null, plan: null, running: false };
const trProg = {};

function escapeHtml(s) {
  const d = document.createElement('div'); d.textContent = String(s); return d.innerHTML;
}

function trShowPanels(p) {
  const ids = { data: 'tr-data', gate: 'tr-gate', run: 'tr-run', result: 'tr-result' };
  for (const k in ids) {
    const el = document.getElementById(ids[k]);
    if (el) el.style.display = p[k] ? '' : 'none';
  }
}

function trInit() {
  if (!REAL) {
    trShowPanels({ data: true });
    return;
  }
  pywebview.api.training_status().then(st => {
    if (!st || !st.ok) { trShowPanels({ data: true }); return; }
    const cur = document.getElementById('tr-current');
    const rbTop = document.getElementById('tr-rollback-top');
    if (cur) {
      if (st.active_f1 != null || st.status === 'trained') {
        cur.style.display = 'block';
        cur.textContent = 'Current model: F1 '
          + (st.active_f1 != null ? Number(st.active_f1).toFixed(2) : 'unknown');
      } else cur.style.display = 'none';
    }
    // rollback must stay reachable after a relaunch, not only on the
    // train_done panel of the session that trained
    if (rbTop) rbTop.style.display = st.rollback ? '' : 'none';
    // local pipeline still running in-process (convert/upload/datasets):
    // show the live run view — events keep streaming into it
    if (st.status === 'preparing') {
      trShowPanels({ run: true });
      trFeedLine('a training run is active — live progress continues below', null);
      return;
    }
    // in_progress / needs_wire: re-attach the cloud watcher. 'unknown' means
    // one describe call failed (network blip) while a run IS pending — the
    // watcher's own retry loop is the right tool, so attach anyway.
    if (st.status === 'in_progress' || st.status === 'needs_wire'
        || st.status === 'unknown') { trEnterWatch(); return; }
    if (st.aborted_attempt)
      showNote('An earlier training attempt was interrupted before reaching '
               + 'AWS. Train again with the same folder — the partial upload '
               + 'is re-used and overwritten safely.', 7000);
    else if (st.last_failure && st.last_failure.status)
      showNote('The last training run ended ' + st.last_failure.status
               + ' — pick a folder to try again.');
    trShowPanels({ data: true });
  }).catch(() => trShowPanels({ data: true }));
}

async function trPick() {
  if (!REAL) { showNote('Preview mode — in the installed app this opens a folder picker.'); return; }
  const r = await pywebview.api.pick_training_folder();
  if (!r || !r.ok) { if (r && r.error) showNote(r.error); return; }
  TR.path = r.path;
  document.getElementById('tr-path').textContent = r.path;
  document.getElementById('tr-report').style.display = 'block';
  document.getElementById('tr-counts').textContent = 'Reading the folder…';
  ['tr-classes', 'tr-warnings', 'tr-blockers'].forEach(id => {
    const el = document.getElementById(id); if (el) el.innerHTML = '';
  });
  trShowPanels({ data: true });
  const rep = await pywebview.api.analyze_training_folder(r.path);
  trRenderReport(rep);
}

function trRenderReport(rep) {
  const counts = document.getElementById('tr-counts');
  const classesBox = document.getElementById('tr-classes');
  const warnBox = document.getElementById('tr-warnings');
  const blockBox = document.getElementById('tr-blockers');
  TR.report = rep; TR.classId = null; TR.plan = null;
  if (!rep || !rep.ok) {
    counts.textContent = '';
    blockBox.textContent = '✕ ' + ((rep && rep.error) || 'Could not read that folder.');
    trShowPanels({ data: true });
    return;
  }
  const parts = Object.keys(rep.splits).map(s => s + ': ' + rep.splits[s].boxed + ' labeled');
  counts.textContent = 'Layout ' + rep.layout + ' · ' + parts.join(' · ');
  classesBox.innerHTML = '';
  if (rep.classes.length > 1) {
    const head = document.createElement('div');
    head.style.cssText = 'font-size:12.5px;font-weight:600;margin-bottom:4px';
    head.textContent = 'This folder labels ' + rep.classes.length
      + ' classes — Argus trains ONE. Pick the target:';
    classesBox.appendChild(head);
  }
  rep.classes.forEach(c => {
    const lab = document.createElement('label');
    lab.style.cssText = 'display:flex;gap:8px;align-items:center;font-size:13px;padding:3px 0;cursor:pointer';
    const rb = document.createElement('input');
    rb.type = 'radio'; rb.name = 'tr-class'; rb.value = c.id;
    rb.onchange = () => trChooseClass(c.id);
    if (rep.classes.length === 1) rb.checked = true;
    const span = document.createElement('span');
    span.textContent = c.name + ' — ' + c.images + ' images, ' + c.boxes + ' boxes';
    lab.append(rb, span);
    classesBox.appendChild(lab);
  });
  warnBox.innerHTML = (rep.warnings || []).map(w => '⚠ ' + escapeHtml(w)).join('<br>');
  blockBox.innerHTML = (rep.blockers || []).map(b => '✕ ' + escapeHtml(b)).join('<br>');
  if (rep.blockers && rep.blockers.length) { trShowPanels({ data: true }); return; }
  if (rep.classes.length === 1) trChooseClass(rep.classes[0].id);
}

async function trChooseClass(cid) {
  TR.classId = cid;
  if (!REAL) return;
  const plan = await pywebview.api.plan_training(TR.report, cid);
  TR.plan = plan;
  const blockBox = document.getElementById('tr-blockers');
  if (!plan || !plan.ok) {
    blockBox.textContent = '✕ ' + ((plan && plan.error) || 'Could not plan the split.');
    return;
  }
  if (plan.blockers && plan.blockers.length) {
    blockBox.innerHTML = plan.blockers.map(b => '✕ ' + escapeHtml(b)).join('<br>');
    trShowPanels({ data: true });
    return;
  }
  blockBox.innerHTML = '';
  document.getElementById('tr-cost').textContent = '≈ $' + plan.est_cost_usd;
  document.getElementById('tr-cost-detail').textContent =
    plan.train + ' TRAINING + ' + plan.test + ' TEST IMAGES'
    + (plan.auto_split ? ' (SPLIT AUTOMATICALLY)' : '')
    + ' · EST. ' + plan.est_hours + ' H AT ~US$4/TRAINING-HOUR · BILLED BY AWS';
  document.getElementById('tr-confirm').value = '';
  document.getElementById('tr-start').disabled = true;
  trShowPanels({ data: true, gate: true });
}

function trGateCheck() {
  document.getElementById('tr-start').disabled =
    (document.getElementById('tr-confirm').value || '').trim().toUpperCase() !== 'TRAIN';
}

async function trStart() {
  if (!REAL) { showNote('Preview mode — training works in the installed app.'); return; }
  if (TR.classId == null || !TR.path || TR.running) return;
  const cls = ((TR.report || {}).classes || []).find(c => c.id === TR.classId) || {};
  // Claim the UI FIRST: the worker starts emitting events before the bridge
  // promise resolves, and a reset-after-await would wipe those first lines
  // (and an un-disabled button invites a double-start).
  TR.running = true;
  document.getElementById('tr-start').disabled = true;
  trResetRail();
  trShowPanels({ run: true });
  let r = null;
  try {
    r = await pywebview.api.start_training(
      { path: TR.path, class_id: TR.classId, class_name: cls.name });
  } catch (e) { r = { ok: false, error: 'Could not reach the deployer: ' + e }; }
  if (!r || !r.ok) {
    TR.running = false;
    showNote((r && r.error) || 'Could not start training.');
    trShowPanels({ data: true, gate: true });   // back to the gate to retry
    trGateCheck();
    return;
  }
}

async function trEnterWatch() {
  trResetRail();
  [0, 1, 2, 3].forEach(i => trRailStatus(i, 'done'));   // pipeline is already training
  trRailStatus(4, 'running');
  trFeedLine('re-attached — training continues in AWS even while this app is closed', null);
  trShowPanels({ run: true });
  try {
    const r = await pywebview.api.watch_training();
    if (!(r && r.ok)) trFeedLine((r && r.error) || 'Could not attach to the run.', false);
  } catch (e) { trFeedLine('Could not attach: ' + e, false); }
}

function trResetRail() {
  document.querySelectorAll('#tr-rail li').forEach((li, i) => {
    li.classList.remove('on', 'done');
    const d = li.querySelector('.dot'); if (d) d.textContent = String(i + 1);
  });
  const feed = document.getElementById('tr-feed'); if (feed) feed.innerHTML = '';
  for (const k in trProg) delete trProg[k];
  const el = document.getElementById('tr-elapsed'); if (el) el.textContent = '';
}

function trRailStatus(i, status) {
  const li = document.querySelectorAll('#tr-rail li')[i];
  if (!li) return;
  li.classList.toggle('on', status === 'running');
  li.classList.toggle('done', status === 'done');
  if (status === 'done') { const d = li.querySelector('.dot'); if (d) d.textContent = ''; }
}

function trFeedLine(text, ok) {
  const feed = document.getElementById('tr-feed'); if (!feed) return;
  const tag = ok === true ? '  <span class="ok">OK</span>'
            : ok === false ? '  <span class="ok" style="color:var(--caution)">FAIL</span>' : '';
  const div = document.createElement('div');
  div.innerHTML = '<span class="ts">' + new Date().toLocaleTimeString() + '</span>'
    + escapeHtml(text) + tag;
  feed.appendChild(div);
  requestAnimationFrame(() => div.classList.add('show'));
  feed.scrollTop = feed.scrollHeight;
}

function trProgressLine(phase, done, total) {
  const feed = document.getElementById('tr-feed'); if (!feed) return;
  let div = trProg[phase];
  if (!div || !div.isConnected) {
    div = document.createElement('div');
    div.classList.add('show');
    feed.appendChild(div);
    trProg[phase] = div;
  }
  div.innerHTML = '<span class="ts">' + new Date().toLocaleTimeString() + '</span>'
    + escapeHtml(phase) + '  ' + done + ' / ' + total;
  feed.scrollTop = feed.scrollHeight;
}

function fmtElapsed(s) {
  s = Math.max(0, s | 0);
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
  return h ? h + ' h ' + String(m).padStart(2, '0') + ' min' : m + ' min';
}

function trEvent(e) {
  if (e.kind === 'train_phase') {
    trRailStatus(e.index, e.status);
    if (e.status === 'running') fireLock((e.label || '').toUpperCase());
    if (e.status === 'done') triggerShutter(false);
    return;
  }
  if (e.kind === 'train_log') { trFeedLine(e.line || '', e.ok); return; }
  if (e.kind === 'train_progress') { trProgressLine(e.phase, e.done, e.total); return; }
  if (e.kind === 'train_started') { trFeedLine('submitted: ' + e.version, true); return; }
  if (e.kind === 'train_status') {
    const el = document.getElementById('tr-elapsed');
    if (el) el.textContent = (e.status || '').replace(/_/g, ' ').toLowerCase()
      + ' · ' + fmtElapsed(e.elapsed || 0) + ' elapsed';
    return;
  }
  if (e.kind === 'train_done') { trDone(e); return; }
  if (e.kind === 'train_error') {
    TR.running = false;
    trFeedLine(e.message || 'Training failed.', false);
    // Reopen the cost gate when a plan is still valid — on a single-class
    // dataset the checked radio never fires onchange again, so without this
    // there is no path back to the Start button short of re-picking.
    const retry = !!(TR.plan && TR.plan.ok && (!TR.plan.blockers || !TR.plan.blockers.length));
    trShowPanels({ data: true, gate: retry, run: true });
    if (retry) {
      document.getElementById('tr-confirm').value = '';
      trGateCheck();
    }
    return;
  }
}

function trF1Words(f1) {
  if (f1 == null) return 'The engine did not report a score.';
  if (f1 >= 0.9) return 'Strong: it finds most of what is there and is rarely wrong.';
  if (f1 >= 0.7) return 'Workable: expect some misses and false alarms — more varied photos of the real scene improve it.';
  return 'Weak: the model needs more, and more varied, labeled photos of the real deployment scene.';
}

function trDone(e) {
  TR.running = false;
  trRailStatus(5, 'done');
  const f1 = (e.f1 != null) ? Number(e.f1) : null;
  document.getElementById('tr-f1').textContent = f1 != null ? 'F1 ' + f1.toFixed(2) : 'Trained';
  const wiredMsg = e.wired
    ? ' Wired into ' + e.wired + ' camera(s) — new photos are scored by this model from now on.'
    : ' NOT attached to any camera yet: no camera is set to use a custom model — open the dashboard camera settings to attach it.';
  const billed = e.billable_s
    ? ' AWS billed ' + fmtElapsed(e.billable_s) + ' of training time.' : '';
  document.getElementById('tr-f1-note').textContent = trF1Words(f1) + wiredMsg + billed;
  document.getElementById('tr-rollback').style.display = e.rollback ? '' : 'none';
  document.getElementById('tr-rollback-msg').textContent = '';
  trShowPanels({ run: true, result: true });
  triggerShutter(false);
}

function trReset() {
  TR.path = ''; TR.report = null; TR.classId = null; TR.plan = null;
  document.getElementById('tr-path').textContent = '';
  document.getElementById('tr-report').style.display = 'none';
  ['tr-classes', 'tr-warnings', 'tr-blockers'].forEach(id => {
    const el = document.getElementById(id); if (el) el.innerHTML = '';
  });
  trShowPanels({ data: true });
  trInit();
}

async function trRollback() {
  if (!REAL) { showNote('Preview mode — rollback works in the installed app.'); return; }
  if (!confirm('Point every camera back at the PREVIOUS model?')) return;
  const msg = document.getElementById('tr-rollback-msg');
  const say = t => {
    if (msg && document.getElementById('tr-result').style.display !== 'none')
      msg.textContent = t;
    else showNote(t, 6000);   // called from the top button, result panel hidden
  };
  say('Rolling back…');
  let r = null;
  try { r = await pywebview.api.rollback_model(); }
  catch (e) { r = { ok: false, error: 'Could not reach the deployer: ' + e }; }
  if (r && r.ok) {
    say('✓ Previous model restored on ' + r.wired + ' camera(s).'
      + (r.f1 != null ? ' Its F1 was ' + Number(r.f1).toFixed(2) + '.' : '')
      + ' If the newer model is currently running, stop it from the dashboard.');
    document.getElementById('tr-rollback').style.display = 'none';
    const rbTop = document.getElementById('tr-rollback-top');
    if (rbTop) rbTop.style.display = 'none';
    const cur = document.getElementById('tr-current');
    if (cur && r.f1 != null) cur.textContent = 'Current model: F1 ' + Number(r.f1).toFixed(2);
  } else say((r && r.error) || 'Rollback failed.');
}

/* advance the embedded-AWS guidance rail as AWS's own URL changes */
function advanceAwsRail(url) {
  const u = document.getElementById('aws-url');
  if (u && url) u.textContent = url.replace(/^https?:\/\//, '').slice(0, 52);
  const st = document.getElementById('aws-state');
  if (st) st.textContent = 'CONNECTED \u00b7 AWS';
  const items = document.querySelectorAll('#acct-rail li');
  if (!items.length) return;
  // Heuristic milestones from AWS signup/console URLs (URL only, never page content)
  let step = 0;
  if (/email|verify/i.test(url)) step = 1;
  if (/payment|billing|credit/i.test(url)) step = 2;
  if (/phone|identity|confirm/i.test(url)) step = 3;
  if (/console\.aws|iam/i.test(url)) step = items.length - 1;
  // A signed-in console (console home / IAM dashboard) means the account exists
  // and the user is authenticated — the whole signup rail is moot.
  const signedIn = /console\.aws\.amazon\.com\/(console\/home|iam)/i.test(url);
  if (signedIn) step = items.length;
  // Keep the CLICK counter in sync with the VISUAL rail. Before 2026-07-15 only
  // the visuals advanced, so a signed-in user still had to click "Step complete"
  // four times to get past a rail that already showed done.
  acctStep = Math.min(step, items.length - 1);
  items.forEach((li, i) => {
    li.classList.toggle('done', i < step);
    li.classList.toggle('on', i === step);
    if (i < step) { const d = li.querySelector('.dot'); if (d) d.textContent = ''; }
  });
  if (signedIn) {
    const hint = document.getElementById('aws-hint');
    if (hint) hint.textContent = 'You are signed in — press “Step complete” once to continue.';
    if (st) st.textContent = 'SIGNED IN · AWS';
  }
}
</script>
</body>
