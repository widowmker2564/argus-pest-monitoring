/* hold-to-deploy (800ms, release cancels) */
(function () {
  const btn = document.getElementById('deploy-btn');
  const fill = document.getElementById('hold-fill');
  let t0 = null, raf = null;
  function step() {
    const p = Math.min(1, (performance.now() - t0) / 800);
    fill.style.clipPath = `inset(0 ${(1 - p) * 100}% 0 0 round 980px)`;
    if (p >= 1) { cancel(); go('theater'); return; }
    raf = requestAnimationFrame(step);
  }
  function start(e) { e.preventDefault(); t0 = performance.now(); raf = requestAnimationFrame(step); }
  function cancel() { if (raf) cancelAnimationFrame(raf); raf = null; fill.style.clipPath = 'inset(0 100% 0 0 round 980px)'; }
  btn.addEventListener('pointerdown', start);
  btn.addEventListener('pointerup', cancel);
  btn.addEventListener('pointerleave', cancel);
  btn.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { go('theater'); } });
})();

/* theater */
const STAGES = [
  ['f/16',  'CREATE  iam · 6 roles, least-privilege',       1500],
  ['f/11',  'CREATE  dynamodb · 4 tables + index',          1300],
  ['f/8',   'CREATE  s3 · frames · processing · dashboard', 1400],
  ['f/5.6', 'BUILD   pillow 12.2 · detection runtime',      1700],
  ['f/4',   'CREATE  lambda · 5 functions',                 1800],
  ['f/2.8', 'CREATE  cognito · private sign-in',            1100],
  ['f/2',   'CREATE  api · 21 routes, JWT',                 1500],
  ['f/1.7', 'PUBLISH dashboard · https, cdn',               1500],
  ['f/1.4', 'CREATE  rekognition · project ready',          1000],
];
/* Deployment progress -> aperture opening, with perceptual easing. A linear
   map spends the first half of the deploy visually near-closed (the "opening
   is too subtle" complaint): pow(p, .55) front-loads the motion so the first
   stages visibly swing the blades, and .12 keeps a real f/16 look at start. */
function apertureProgress(p) {
  return .12 + .88 * Math.pow(Math.max(0, Math.min(1, p)), .55);
}

let theaterTimers = [];
function runTheater() {
  theaterTimers.forEach(clearTimeout); theaterTimers = [];
  const feed = document.getElementById('feed');
  const fstop = document.getElementById('fstop');
  const tplus = document.getElementById('tplus');
  const nextBtn = document.getElementById('theater-next');
  feed.innerHTML = ''; nextBtn.classList.remove('show');
  fstop.textContent = 'f/16';
  AP.topen = apertureProgress(0);
  const t0 = performance.now();
  const clock = setInterval(() => {
    const s = (performance.now() - t0) / 1000;
    tplus.textContent = 'T+' + String(Math.floor(s / 60)).padStart(2, '0') + ':' +
      (s % 60).toFixed(1).padStart(4, '0');
  }, 100);
  theaterTimers.push(clock);
  let acc = 700;
  STAGES.forEach(([f, line, dur], i) => {
    acc += dur;
    theaterTimers.push(setTimeout(() => {
      fstop.textContent = f;
      AP.topen = apertureProgress((i + 1) / STAGES.length);
      triggerShutter(false);   // each finished stage = the camera "captures" it
      const s = (performance.now() - t0) / 1000;
      const ts = 'T+' + String(Math.floor(s / 60)).padStart(2, '0') + ':' +
        (s % 60).toFixed(1).padStart(4, '0');
      const div = document.createElement('div');
      div.innerHTML = '<span class="ts">' + ts + '</span>' + line + '  <span class="ok">OK</span>';
      feed.appendChild(div);
      requestAnimationFrame(() => div.classList.add('show'));
      fireLock(line.split('·')[0].replace('CREATE', '').replace('BUILD', '').replace('PUBLISH', '').trim().toUpperCase());
      if (i === STAGES.length - 1) {
        clearInterval(clock);
        theaterTimers.push(setTimeout(() => nextBtn.classList.add('show'), 700));
      }
    }, acc));
  });
}

