/* ==================================================================
   BRIDGE — real desktop app (pywebview) vs standalone preview.
   When window.pywebview.api exists, the wizard drives the real
   deploy.py backend; otherwise every action is simulated so the
   same file doubles as a clickable preview.
   ================================================================== */
/* pywebview injects window.pywebview.api ASYNCHRONOUSLY after page load, so a
   load-time const would read false even in the real app (a race). REAL is now a
   live binding upgraded by the 'pywebviewready' event. */
let REAL = !!(window.pywebview && window.pywebview.api);
window.addEventListener('pywebviewready', () => {
  REAL = !!(window.pywebview && window.pywebview.api);
  initResume();
});

/* ==================================================================
   RESUME — an interrupted session must never cost the user progress.
   Three cases on launch, checked in priority order:
     complete  -> jump offer to the summary (URL restored from state)
     partial   -> offer to resume the deployment (stages are idempotent:
                  finished pieces are adopted, missing ones created)
     screen    -> offer to continue at the step they left (config fields
                  restored; stored IAM key marks the keys step done)
   The offer is a bar, not an auto-jump: the user stays in control.
   ================================================================== */
function restoreCfg() {
  try {
    const c = JSON.parse(localStorage.getItem('argus.cfg') || '{}');
    const set = (id, v) => { const el = document.getElementById(id); if (el && v) el.value = v; };
    set('pname', c.deployment_name); set('target', c.target_label);
    set('email', c.sender_email); set('recipient_email', c.recipient_email);
    // region select stores option TEXT ("Singapore (ap-southeast-1)") while the
    // cfg stores the code — re-select by matching the code in parentheses
    const sel = document.getElementById('region');
    if (sel && c.region) {
      for (const o of sel.options) {
        if (o.text.includes('(' + c.region + ')')) { sel.value = o.text; break; }
      }
    }
  } catch (e) {}
}

function showResumeBar(text, btnLabel, action) {
  const old = document.getElementById('resume-bar');
  if (old) old.remove();                      // never stack two offers
  const bar = document.createElement('div');
  bar.id = 'resume-bar';
  bar.style.cssText = 'position:fixed;top:64px;left:50%;transform:translateX(-50%);'
    + 'display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.92);'
    + 'backdrop-filter:blur(10px);border:1px solid rgba(30,40,60,.14);border-radius:12px;'
    + 'padding:12px 18px;z-index:800;box-shadow:0 10px 40px rgba(20,30,50,.12);font-size:13.5px';
  const span = document.createElement('span');
  span.textContent = text;
  const okBtn = document.createElement('button');
  okBtn.className = 'btn'; okBtn.style.padding = '8px 16px'; okBtn.textContent = btnLabel;
  okBtn.onclick = () => { bar.remove(); action(); };
  const dis = document.createElement('a');
  dis.href = '#'; dis.textContent = 'Start over';
  dis.style.cssText = 'color:var(--muted);font-size:12.5px';
  dis.onclick = (e) => { e.preventDefault();
    try { localStorage.removeItem('argus.screen'); localStorage.removeItem('argus.cfg'); } catch (x) {}
    bar.remove(); };
  bar.append(span, okBtn, dis);
  document.body.appendChild(bar);
}

async function initResume() {
  if (!REAL) return;
  try {
    // Liveness probe first: if the stored key no longer AUTHENTICATES (account
    // closed or key revoked), every resume offer below would be lies about a
    // world that no longer exists. Network errors are deliberately NOT treated
    // as a dead account.
    try {
      const alive = await pywebview.api.account_alive();
      if (alive && !alive.ok && alive.reason === 'auth') {
        showResumeBar('Your stored AWS key no longer works — the account may be closed or the key revoked.',
          'Start fresh', async () => {
            try { await pywebview.api.forget_credentials(); } catch (e) {}
            try { localStorage.removeItem('argus.screen'); localStorage.removeItem('argus.cfg'); } catch (e) {}
            go('welcome');
          });
        return;
      }
    } catch (e) {}
    const st = await pywebview.api.deployment_status();
    if (st && st.status === 'complete') {
      restoreCfg();   // keep the form aligned with the deployment that exists
      if (st.dashboard) { const u = document.getElementById('dash-url'); if (u) u.value = st.dashboard; }
      // A training run may still be in flight from the last session — that
      // offer outranks the plain summary (go('train') re-attaches the watcher).
      try {
        const ts = await pywebview.api.training_status();
        if (ts && ts.ok && (ts.status === 'in_progress' || ts.status === 'needs_wire'
                            || ts.status === 'unknown')) {
          showResumeBar('A model training run from your last session is still in progress.',
                        'Watch it', () => go('train'));
          return;
        }
      } catch (e) {}
      showResumeBar('This account already has a completed Argus deployment.',
                    'Open the summary', () => go('done'));
      return;
    }
    if (st && st.status === 'partial') {
      restoreCfg();
      showResumeBar('Your last deployment was interrupted after “' + (st.last_stage || 'start')
                    + '”. Finished pieces are kept — resuming only builds what is missing.',
                    'Resume deployment', () => go('theater'));
      return;
    }
    const saved = localStorage.getItem('argus.screen');
    if (saved && saved !== 'welcome' && document.getElementById('s-' + saved)) {
      restoreCfg();
      showResumeBar('Pick up where you left off?', 'Continue', async () => {
        if (saved === 'keys') {
          try { const c = await pywebview.api.has_credentials();
                if (c && c.ok) { go('config'); return; } } catch (e) {}
        }
        go(saved);
      });
    }
  } catch (e) {}
}

/* ==================================================================
   SYSTEM CHECK — live, read-only audit of the deployed stack. Every
   resource Argus created is described against AWS right now; the
   result is per-resource proof, not a claim.
   ================================================================== */
async function runSystemCheck() {
  const box = document.getElementById('syscheck');
  if (!box) return;
  box.style.display = 'block';
  if (!REAL) {
    box.innerHTML = '<span style="color:var(--muted)">Preview mode — in the installed app this '
      + 'checks every deployed resource against AWS and lists each one as LIVE or MISSING.</span>';
    return;
  }
  box.innerHTML = '<span style="color:var(--muted)">Checking every resource…</span>';
  let cfg = {};
  try { cfg = JSON.parse(localStorage.getItem('argus.cfg') || '{}'); } catch (e) {}
  try {
    const r = await pywebview.api.verify_deployment(cfg);
    if (!r || !r.ok) {
      box.innerHTML = '<span style="color:var(--caution)">Check failed: '
        + ((r && r.error) || 'unknown error') + '</span>';
      return;
    }
    const rows = r.checks.map(c =>
      '<div>' + (c.ok ? '<span style="color:var(--ok)">● LIVE</span>'
                      : '<span style="color:var(--caution)">○ MISSING</span>')
      + '  ' + c.name + (c.detail ? '  <span style="color:var(--muted)">' + c.detail + '</span>' : '')
      + '</div>').join('');
    box.innerHTML = '<div style="margin-bottom:8px"><b>' + r.present + ' / ' + r.total
      + ' resources live</b>' + (r.present === r.total
        ? ' — deployment is complete.' : ' — some pieces are missing; Resume deployment rebuilds them.')
      + '</div>' + rows;
  } catch (e) {
    box.innerHTML = '<span style="color:var(--caution)">Check failed: ' + e + '</span>';
  }
}

