<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ARGUS Setup</title>
<style>
  :root {
    --void:#eef1f5; --carbon:rgba(255,255,255,.55); --ink:#1d1d1f; --muted:#6e6e73;
    --muted-dark:#6e6e73;
    --hairline:rgba(30,40,60,.10); --hairline2:rgba(30,40,60,.20);
    --teal:#0a84ff; --violet:#af52de; --ok:#248a3d; --caution:#c93400;
    --glass:rgba(255,255,255,.38);
    --grad:linear-gradient(110deg,#1d1d1f 5%,#0a84ff 55%,#af52de 95%);
    --ease-out:cubic-bezier(.16,1,.3,1);
    --ease-snap:cubic-bezier(.34,1.2,.44,1);
    --ease-quiet:cubic-bezier(.4,0,.2,1);
    --mono:ui-monospace,"SF Mono","Cascadia Code",Consolas,monospace;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI Variable Display","Segoe UI",sans-serif;
    background:var(--void); color:var(--ink); overflow:hidden;
    -webkit-font-smoothing:antialiased;
  }
  button{font:inherit;cursor:pointer}
  :focus-visible{outline:2px solid var(--teal);outline-offset:3px;border-radius:6px}
  #atmosphere{position:fixed;inset:0;z-index:-1;pointer-events:none}
  #stage{position:fixed;inset:0;z-index:0}
  #grain{position:fixed;inset:0;z-index:50;pointer-events:none;opacity:.02}

  /* ---------- chrome ---------- */
  .titlebar{
    position:fixed;top:0;left:0;right:0;height:54px;z-index:40;
    display:flex;align-items:center;justify-content:space-between;padding:0 26px;
    border-bottom:1px solid var(--hairline);
    background:rgba(255,255,255,.55);backdrop-filter:blur(22px) saturate(140%);
  }
  .wordmark{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:600;letter-spacing:.06em}
  .wordmark svg{display:block}
  .wordmark span{color:var(--muted);font-weight:400;letter-spacing:0;margin-left:2px}
  .titlebar a{color:var(--muted);font-size:13px;text-decoration:none}
  .titlebar a:hover{color:var(--ink)}

  .screen{position:fixed;inset:54px 0 0 0;z-index:10;overflow-y:auto;display:none}
  .screen.active{display:block}
  .inner{max-width:720px;margin:0 auto;padding:64px 40px 110px;position:relative}
  .rv{opacity:0;transform:translateY(18px)}
  .active .rv{animation:rise .8s var(--ease-out) both;animation-delay:calc(var(--i,0)*90ms)}
  @keyframes rise{to{opacity:1;transform:none}}

  .eyebrow{font-size:13px;color:var(--muted);letter-spacing:.14em;margin-bottom:14px}
  h2{font-size:38px;font-weight:700;letter-spacing:-.024em;line-height:1.1;margin-bottom:12px;text-wrap:balance}
  .lede{font-size:16.5px;line-height:1.55;color:var(--muted);max-width:52ch}
  .grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .mono{font-family:var(--mono)}

  .btn{
    display:inline-flex;align-items:center;gap:9px;border-radius:980px;
    padding:12px 26px;font-size:15px;font-weight:500;color:var(--ink);
    background:transparent;border:1px double rgba(30,40,60,.14);
    transition:border-color .18s var(--ease-quiet),background .18s var(--ease-quiet),transform .3s var(--ease-snap);
    position:relative;
  }
  .btn:hover{border-color:rgba(255,255,255,.4);background:rgba(100,210,255,.08)}
  .btn:active{transform:scale(.965)}
  .btn[disabled]{opacity:.35;cursor:default}
  .btn .arr{width:12px;height:12px;transition:transform .3s var(--ease-snap)}
  .btn:hover .arr{transform:translateX(3px)}
  .back{background:none;border:none;color:var(--muted);font-size:14.5px}
  .back:hover{color:var(--ink)}
  .nav{display:flex;justify-content:space-between;align-items:center;margin-top:48px;padding-top:26px;border-top:1px solid var(--hairline)}

  /* ---------- welcome ---------- */
  #s-welcome .hero{
    min-height:calc(100vh - 54px);display:flex;flex-direction:column;
    align-items:center;justify-content:flex-end;text-align:center;padding:0 24px 9vh;
  }
  #s-welcome h1{font-size:clamp(46px,6.4vw,84px);font-weight:700;letter-spacing:-.03em;line-height:1.04}
  #s-welcome .sub{font-size:18px;color:var(--muted);max-width:54ch;line-height:1.5;margin:20px 0 34px}
  .statusline{margin-top:46px;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;color:#9a9aa0}

  /* ---------- glass panels ---------- */
  .glass{
    background:var(--glass);backdrop-filter:blur(12px) saturate(170%);
    border:1px solid var(--hairline);border-radius:14px;
    box-shadow:inset 1.5px -1.5px 1px -.5px rgba(255,255,255,1),inset -1.5px 1.5px 1px -.5px rgba(255,255,255,.95),inset 0 0 2px rgba(30,40,60,.18), 0 10px 30px -14px rgba(29,29,31,.18);
  }

  /* ---------- consent ---------- */
  .legal-cols{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px}
  @media(max-width:760px){.legal-cols{grid-template-columns:1fr}}
  .legal{padding:22px 24px;max-height:300px;overflow-y:auto}
  .legal h3{font-size:14px;font-weight:600;letter-spacing:.02em;margin-bottom:12px;display:flex;gap:10px;align-items:baseline}
  .legal h3 .n{font-family:var(--mono);font-size:11px;color:var(--teal)}
  .legal li{font-size:13.5px;line-height:1.6;color:var(--muted);margin:0 0 10px 16px}
  .legal p.more{font-size:12px;color:#8a8a90;margin-top:8px}
  .consent-row{display:flex;align-items:center;gap:14px;margin-top:26px}
  .ringbtn{position:relative;display:inline-flex}
  .ringbtn svg{position:absolute;inset:-5px;width:calc(100% + 10px);height:calc(100% + 10px);pointer-events:none}
  .ringbtn circle{fill:none;stroke:var(--teal);stroke-width:1.5;opacity:.9}
  .quietnote{font-size:12.5px;color:#8a8a90;margin-top:18px}

  /* ---------- assist (embedded AWS) ---------- */
  .assist{display:grid;grid-template-columns:280px 1fr;gap:20px;margin-top:28px}
  @media(max-width:820px){.assist{grid-template-columns:1fr}}
  .rail{border-left:1px solid var(--hairline);padding-left:0}
  .rail ol{list-style:none}
  .rail li{display:flex;gap:14px;padding:13px 0 13px 18px;margin-left:-1px;border-left:1px solid transparent}
  .rail .dot{
    width:24px;height:24px;flex:none;border-radius:50%;border:1.5px solid var(--hairline2);
    display:grid;place-items:center;font-family:var(--mono);font-size:11px;color:var(--muted);
    transition:all .35s var(--ease-snap);
  }
  .rail li.on{border-left-color:var(--teal)}
  .rail li.on .dot{border-color:var(--teal);color:var(--teal);box-shadow:0 0 14px -2px rgba(100,210,255,.55)}
  .rail li.done .dot{border-color:var(--ok);background:var(--ok);color:#04270f}
  .rail h4{font-size:14px;font-weight:600}
  .rail li.on h4{color:var(--ink)} .rail h4{color:var(--muted)}
  .rail p{font-size:12.5px;color:#8a8a90;line-height:1.5;margin-top:3px;max-width:26ch}
  .viewport{position:relative;border-radius:12px;border:1px double rgba(30,40,60,.14);overflow:hidden;background:#f7f9fc}
  .vhead{display:flex;align-items:center;gap:9px;padding:10px 14px;border-bottom:1px solid var(--hairline);background:rgba(30,40,60,.04)}
  .vhead svg{width:11px;height:13px}
  .vhead .url{font-family:var(--mono);font-size:11.5px;color:var(--muted);letter-spacing:.03em}
  .vbody{padding:34px 38px;min-height:260px}
  .ghost{max-width:330px;margin:0 auto}
  .ghost .gh-title{font-size:16px;font-weight:600;color:#3a3a3f;margin-bottom:18px}
  .ghost label{display:block;font-size:11.5px;color:#8a8a90;margin:14px 0 6px}
  .ghost .gfield{height:38px;border:1px solid rgba(30,40,60,.14);border-radius:8px;background:#ffffff}
  .ghost .gbtn{margin-top:20px;height:38px;border-radius:8px;background:rgba(30,40,60,.08);display:grid;place-items:center;font-size:13px;color:#6e6e73}
  .vnote{position:absolute;bottom:12px;left:0;right:0;text-align:center;font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:#9a9aa0}
  .vp-brackets i{position:absolute;width:18px;height:18px;border:2px solid var(--teal);opacity:0;transition:opacity .3s}
  .vp-brackets i:nth-child(1){top:8px;left:8px;border-right:none;border-bottom:none}
  .vp-brackets i:nth-child(2){top:8px;right:8px;border-left:none;border-bottom:none}
  .vp-brackets i:nth-child(3){bottom:8px;left:8px;border-right:none;border-top:none}
  .vp-brackets i:nth-child(4){bottom:8px;right:8px;border-left:none;border-top:none}
  .viewport.locked .vp-brackets i{opacity:1}

  /* ---------- fields ---------- */
  .fieldwrap{position:relative;margin-top:6px}
  .fld{
    width:100%;font-family:var(--mono);font-size:14px;color:var(--ink);
    background:rgba(255,255,255,.04);border:1px double rgba(30,40,60,.14);
    border-radius:10px;padding:13px 15px;letter-spacing:.02em;
    transition:border-color .2s,box-shadow .2s;
  }
  .fld:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(10,132,255,.14)}
  .fld::placeholder{color:#9a9aa0}
  .flabel{font-size:12.5px;font-weight:600;margin:20px 0 0}
  .fhint{font-size:12px;color:#8a8a90;margin-top:7px}
  .fb i{position:absolute;width:12px;height:12px;border:1.5px solid var(--ok);opacity:0;transition:all .35s var(--ease-snap)}
  .fb i:nth-child(1){top:-4px;left:-4px;border-right:none;border-bottom:none}
  .fb i:nth-child(2){top:-4px;right:-4px;border-left:none;border-bottom:none}
  .fb i:nth-child(3){bottom:-4px;left:-4px;border-right:none;border-top:none}
  .fb i:nth-child(4){bottom:-4px;right:-4px;border-left:none;border-top:none}
  .fieldwrap.locked .fb i{opacity:1;transform:translate(0,0)}
  .okline{display:none;align-items:center;gap:8px;font-size:12.5px;color:var(--ok);margin-top:10px}
  .okline svg{width:12px;height:12px}
  .okline.show{display:flex}

  /* ---------- config ---------- */
  .cfg{padding:30px 32px;margin-top:26px}
  .cfg .row2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  @media(max-width:700px){.cfg .row2{grid-template-columns:1fr}}
  .ufield{width:100%;font-family:inherit;font-size:15px;color:var(--ink);
    background:rgba(255,255,255,.04);border:1px double rgba(30,40,60,.14);
    border-radius:10px;padding:12px 14px;transition:border-color .2s,box-shadow .2s}
  .ufield:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(10,132,255,.14)}
  select.ufield{appearance:none}
  .togglerow{display:flex;align-items:center;justify-content:space-between;padding:16px 0;border-top:1px solid var(--hairline);margin-top:6px}
  .togglerow h4{font-size:14.5px;font-weight:600}
  .togglerow p{font-size:12.5px;color:#8a8a90;margin-top:2px;max-width:44ch}
  .tgl{position:relative;width:44px;height:26px;border-radius:980px;border:none;background:rgba(30,40,60,.18);transition:background .2s;flex:none;margin-left:20px}
  .tgl::after{content:"";position:absolute;top:2px;left:2px;width:22px;height:22px;border-radius:50%;background:#fff;transition:transform .3s var(--ease-snap)}
  .tgl[aria-checked="true"]{background:var(--ok)}
  .tgl[aria-checked="true"]::after{transform:translateX(18px)}
  .live-hint{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;color:#8a8a90;margin-top:16px}
  .live-hint b{color:var(--teal);font-weight:500}

  /* ---------- review ---------- */
  .manifest{margin-top:28px;border-top:1px solid var(--hairline)}
  .mrow{display:flex;justify-content:space-between;align-items:center;padding:13px 4px;border-bottom:1px solid var(--hairline);font-size:14px}
  .mrow .what{font-weight:600}
  .mrow .spec{font-family:var(--mono);font-size:12px;color:var(--muted)}
  .costcard{margin-top:26px;padding:24px 28px;position:relative;overflow:hidden}
  .costcard::before{content:"";position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--caution),transparent);opacity:.6}
  .costcard .clabel{font-size:12px;letter-spacing:.1em;color:var(--muted);margin-bottom:8px}
  .costcard .figure{font-size:42px;font-weight:700;letter-spacing:-.03em}
  .costcard .breakdown{font-family:var(--mono);font-size:12px;color:var(--muted);margin-top:10px;line-height:1.7}
  .holdbtn{position:relative;overflow:visible}
  .holdbtn .fill{position:absolute;inset:-1px;border-radius:980px;border:1.5px solid var(--teal);
    clip-path:inset(0 100% 0 0 round 980px);pointer-events:none}
  .holdhint{font-size:11.5px;color:#8a8a90;margin-top:10px;text-align:right}

  /* ---------- theater ---------- */
  #s-theater .inner{max-width:860px;padding-top:26vh}
  .fstop{display:flex;justify-content:center;gap:26px;align-items:baseline;margin-top:2px;font-family:var(--mono)}
  .fstop .f{font-size:26px;color:var(--ink);font-weight:500}
  .fstop .t{font-size:12px;color:var(--muted);letter-spacing:.08em}
  .simtag{position:absolute;top:18px;right:40px;font-family:var(--mono);font-size:10px;letter-spacing:.16em;color:#8a8a90;border:1px solid var(--hairline);border-radius:6px;padding:4px 9px}
  .feed{margin:30px auto 0;max-width:560px;font-family:var(--mono);font-size:12px;line-height:2.1;color:var(--muted)}
  .feed div{opacity:0;transform:translateY(8px);transition:opacity .4s var(--ease-out),transform .5s var(--ease-out)}
  .feed div.show{opacity:1;transform:none}
  .feed .ok{color:var(--ok)}
  .feed .ts{color:#9a9aa0;margin-right:14px}
  .tcta{text-align:center;margin-top:34px;min-height:50px}
  .tcta .btn{opacity:0}
  .tcta .btn.show{animation:rise .6s var(--ease-snap) both}

  /* ---------- done ---------- */
  #s-done .inner{max-width:640px;text-align:center;padding-top:30vh}
  #s-done h1{font-size:clamp(60px,9vw,110px);font-weight:700;letter-spacing:-.035em}
  #s-done .sub{color:var(--muted);font-size:16.5px;margin:18px 0 36px;line-height:1.55}
  .urlrow{display:flex;gap:10px;align-items:stretch;max-width:520px;margin:0 auto}
  .urlrow .fieldwrap{flex:1;margin:0}
  .closing{margin-top:44px;font-size:13px;color:#8a8a90;font-style:normal}
  .nextrows{max-width:520px;margin:34px auto 0;text-align:left}
  .nextrows button{width:100%;background:none;border:none;border-top:1px solid var(--hairline);
    padding:15px 4px;display:flex;justify-content:space-between;align-items:center;font-size:14.5px;color:var(--ink)}
  .nextrows button:last-child{border-bottom:1px solid var(--hairline)}
  .nextrows .go{color:var(--muted);width:12px;height:12px}

  /* ---------- liquid-glass controls (dark-tuned, from the dashboard v5.2 recipe:
     low blur + inner light rims + hair-thin edge; kept subtle so the machine-eye
     aesthetic stays dominant) ---------- */
  .btn{
    background:rgba(255,255,255,.40);
    backdrop-filter:blur(8px) saturate(170%);
    -webkit-backdrop-filter:blur(8px) saturate(160%);
    box-shadow:
      inset 1.5px -1.5px 1px -.5px rgba(255,255,255,1),
      inset -1.5px 1.5px 1px -.5px rgba(255,255,255,.95),
      inset 0 0 1.5px rgba(30,40,60,.28);
  }
  .btn:hover{background:rgba(255,255,255,.62)}
  .btn.on-dark{background:rgba(10,132,255,.55);color:#fff;text-shadow:0 1px 2px rgba(0,60,130,.35);
    box-shadow:
      inset 1.5px -1.5px 1px -.5px rgba(255,255,255,.38),
      inset -1.5px 1.5px 1px -.5px rgba(255,255,255,.22),
      inset 0 0 2px rgba(0,60,130,.4),
      0 4px 16px -5px rgba(10,132,255,.5)}
  .btn.on-dark:hover{background:rgba(10,132,255,.68)}
  .glass{
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.08),
      inset 1.5px -1.5px 1px -.5px rgba(255,255,255,.14),
      inset -1.5px 1.5px 1px -.5px rgba(255,255,255,.10);
  }
  .fld,.ufield{
    box-shadow:
      inset 1px -1px 1px -.5px rgba(255,255,255,.95),
      inset -1px 1px 1px -.5px rgba(255,255,255,.9),
      inset 0 0 1.5px rgba(30,40,60,.2);
  }
  .tgl{box-shadow:inset 1px -1px 1px -.5px rgba(255,255,255,.25)}
  .viewport{box-shadow:
      inset 1.5px -1.5px 1px -.5px rgba(255,255,255,.14),
      inset -1.5px 1.5px 1px -.5px rgba(255,255,255,.10)}

  /* ---------- consent (checkbox pattern) ---------- */
  .agree-card{padding:22px 24px;border-radius:14px}
  .agree-row{display:flex;align-items:flex-start;gap:12px;cursor:pointer}
  .agree-row input{position:absolute;opacity:0;width:0;height:0}
  .agree-box{width:22px;height:22px;flex:none;border-radius:7px;margin-top:1px;
    border:1.5px solid var(--hairline2);background:rgba(255,255,255,.6);
    display:grid;place-items:center;color:transparent;
    transition:all .25s var(--ease-snap);
    box-shadow:inset 1px -1px 1px -.5px rgba(255,255,255,.9)}
  .agree-box svg{width:12px;height:12px}
  .agree-row input:checked + .agree-box{background:var(--teal);border-color:var(--teal);color:#fff}
  .agree-row input:focus-visible + .agree-box{outline:2px solid var(--teal);outline-offset:2px}
  .agree-text{font-size:14.5px;line-height:1.55;color:var(--ink)}
  .agree-text a{color:var(--teal);text-decoration:none;border-bottom:1px solid rgba(10,132,255,.35)}
  .legal-fold{margin-top:14px;border-top:1px solid var(--hairline);padding-top:12px}
  .legal-fold summary{cursor:pointer;font-size:12.5px;font-weight:600;color:var(--muted);
    letter-spacing:.04em;list-style:none}
  .legal-fold summary::before{content:"+ ";color:var(--teal)}
  .legal-fold[open] summary::before{content:"\2212 "}
  .legal-fold li{font-size:13px;line-height:1.6;color:var(--muted);margin:8px 0 0 16px}
  .legal-fold .more{font-size:11.5px;color:#9a9aa0;margin-top:8px}
  .legal-fold .fulltext{white-space:pre-wrap;font-size:12px;line-height:1.6;color:var(--muted);
    max-height:260px;overflow-y:auto;margin-top:10px;padding-right:8px}
  .vstate{margin-left:auto;font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;color:var(--ok)}
  .vbody-live{display:grid;place-items:center;min-height:260px}
  .aws-launch{max-width:360px;text-align:center;display:flex;flex-direction:column;gap:16px;align-items:center}
  .aws-note{font-size:13.5px;line-height:1.6;color:var(--muted)}
  .aws-sub{font-size:11.5px;color:#9a9aa0}
  .req{font-size:9.5px;letter-spacing:.1em;color:var(--caution);margin-left:8px;font-weight:600}
  .field-err{min-height:16px;font-size:12px;color:var(--caution);margin-top:6px}

  @media (prefers-reduced-motion:reduce){
    .rv,.active .rv,.feed div,.tcta .btn{animation:none!important;transition:none!important;opacity:1!important;transform:none!important}
  }
</style>
</head>
<body>

<canvas id="atmosphere"></canvas>
<canvas id="stage"></canvas>
<canvas id="grain"></canvas>

<div class="titlebar">
  <div class="wordmark">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="#F5F5F7" stroke-width="1">
      <circle cx="11" cy="11" r="9.5" opacity=".55"/>
      <g opacity=".8">
        <line x1="11" y1="2.4" x2="11" y2="6.4"/><line x1="16.6" y1="4.5" x2="14.2" y2="7.7"/>
        <line x1="19.6" y1="9.6" x2="15.8" y2="10.4"/><line x1="18.4" y1="15.4" x2="15" y2="13.3"/>
        <line x1="13.7" y1="19.2" x2="12.6" y2="15.4"/><line x1="8.3" y1="19.2" x2="9.4" y2="15.4"/>
        <line x1="3.6" y1="15.4" x2="7" y2="13.3"/><line x1="2.4" y1="9.6" x2="6.2" y2="10.4"/>
        <line x1="5.4" y1="4.5" x2="7.8" y2="7.7"/>
      </g>
    </svg>
    ARGUS <span>Setup</span>
  </div>
  <a href="#" onclick="exitSetup(); return false">Exit setup</a>
</div>

<!-- ================= WELCOME ================= -->
<section class="screen active" id="s-welcome">
  <div class="hero">
    <div>
      <p class="eyebrow rv" style="--i:6">A R G U S</p>
      <h1 class="rv" style="--i:7">Vision, <span class="grad">deployed.</span></h1>
      <p class="sub rv" style="--i:8">Train it on anything. Deploy it to your own AWS in one
        sitting. Argus watches; you hear from it only when it matters.</p>
      <div class="rv" style="--i:9">
