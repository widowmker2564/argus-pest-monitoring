{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Sid": "BedrockInvokeAnyMultimodalInferenceProfile",
   "Effect": "Allow",
   "Action": [
    "bedrock:InvokeModel",
    "bedrock:Converse"
   ],
   "Resource": [
    "arn:aws:bedrock:us-east-1:366356442579:inference-profile/us.anthropic.*",
    "arn:aws:bedrock:us-east-1:366356442579:inference-profile/global.anthropic.*",
    "arn:aws:bedrock:us-east-1:366356442579:inference-profile/us.amazon.*",
    "arn:aws:bedrock:us-east-1:366356442579:inference-profile/us.meta.*",
    "arn:aws:bedrock:us-east-1:366356442579:inference-profile/us.mistral.*"
   ]
  },
  {
   "Sid": "BedrockInvokeUnderlyingFoundationModels",
   "Effect": "Allow",
   "Action": [
    "bedrock:InvokeModel",
    "bedrock:Converse"
   ],
   "Resource": [
    "arn:aws:bedrock:*::foundation-model/anthropic.*",
    "arn:aws:bedrock:*::foundation-model/amazon.*",
    "arn:aws:bedrock:*::foundation-model/meta.*",
    "arn:aws:bedrock:*::foundation-model/mistral.*"
   ]
  }
 ]
}